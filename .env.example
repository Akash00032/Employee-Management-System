# Copy this file to .env, set both database passwords, and generate JWT_SECRET.
DB_NAME=employee_management_system
DB_USERNAME=ems
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Generate at least 32 random bytes, then Base64-encode them in PowerShell:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000
CORS_ALLOWED_ORIGINS=http://localhost:5173

BACKEND_PORT=8080
FRONTEND_PORT=5173
BACKEND_BIND_ADDRESS=127.0.0.1
FRONTEND_BIND_ADDRESS=127.0.0.1
VITE_API_BASE_URL=/api/v1
JAVA_TOOL_OPTIONS=-XX:InitialRAMPercentage=25.0 -XX:MaxRAMPercentage=75.0
SPRING_PROFILES_ACTIVE=docker
